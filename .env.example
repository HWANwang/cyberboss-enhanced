# Keep the real file outside this repository:
#   Windows: %USERPROFILE%\\.cyberboss\\.env
#   macOS/Linux: ~/.cyberboss/.env
# Or set CYBERBOSS_ENV_FILE to an explicit path before starting Cyberboss.

CYBERBOSS_USER_NAME=ExampleUser
CYBERBOSS_USER_GENDER=neutral
CYBERBOSS_ALLOWED_USER_IDS=replace-with-your-wechat-user-id
CYBERBOSS_ACCOUNT_ID=

# Put all mutable data and private instructions outside the source checkout.
CYBERBOSS_STATE_DIR=/absolute/path/to/cyberboss-state
CYBERBOSS_PRIVATE_DIR=/absolute/path/to/cyberboss-state/private
CYBERBOSS_WORKSPACE_ROOT=/absolute/path/to/your/workspace

CYBERBOSS_RUNTIME=codex
CYBERBOSS_CODEX_COMMAND=codex
CYBERBOSS_CODEX_MODEL=
CYBERBOSS_ENABLE_CHECKIN=false

# Optional channel settings.
CYBERBOSS_WEIXIN_MIN_CHUNK_CHARS=20
CYBERBOSS_WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
CYBERBOSS_WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c

# Optional explicit overrides. Normally the private directory defaults are used.
# CYBERBOSS_WEIXIN_INSTRUCTIONS_FILE=
# CYBERBOSS_WEIXIN_OPERATIONS_FILE=

# Never commit real API keys, location tokens, account IDs, user IDs, session tokens,
# or personal instruction files.
